# Сборка клиента и раздача готовых файлов веб-сервером.
#
# Собранный клиент — это статические файлы: разметка, стили, сценарии. Node в
# итоговом образе не нужен, поэтому сборка выполняется в отдельной стадии, а в
# готовый образ переносится только содержимое каталога dist. Образ получается
# на порядок меньше, и в нём нет ни исходников, ни средств сборки.

FROM node:22-alpine AS build

WORKDIR /app

# Зависимости ставятся отдельным слоем: он пересобирается только при
# изменении package.json, а не при каждой правке исходников
COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build


FROM caddy:2-alpine

COPY --from=build /app/dist /srv
