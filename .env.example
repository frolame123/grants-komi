# Скопировать в .env и заполнить. Файл .env в репозиторий не коммитится.

POSTGRES_USER=grants
POSTGRES_PASSWORD=grants
POSTGRES_DB=grants

DATABASE_URL=postgresql+psycopg2://grants:grants@db:5432/grants

# Секрет подписи JWT: сгенерировать `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=7

PUBLIC_URL=http://localhost:5173
