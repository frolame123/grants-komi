# Скопировать в .env и заполнить. Файл .env в репозиторий не коммитится.

# Доменное имя без протокола. Caddy выпустит на него сертификат
DOMAIN=grantykomi.ru

# База данных
POSTGRES_USER=grants
POSTGRES_PASSWORD=замените-на-сгенерированный-пароль
POSTGRES_DB=grants

# Строка подключения. Имя узла db — это имя службы в docker compose;
# при локальной разработке вне контейнеров заменить на localhost
DATABASE_URL=postgresql+psycopg2://grants:замените-на-сгенерированный-пароль@db:5432/grants

# Ключ подписи токенов:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=замените-на-сгенерированный-ключ
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=7

# Адрес, по которому открывается система. Используется в ссылках писем
# подтверждения адреса и восстановления пароля
PUBLIC_URL=https://grantykomi.ru

# Почта. Пустой SMTP_HOST — письма пишутся в журнал приложения
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@grantykomi.ru
